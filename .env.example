# Copy to .env.local and fill in. Never commit real keys.
# Local values are printed by `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server only — used solely to create employee accounts. Never expose to the browser.
SUPABASE_SECRET_KEY=your-secret-key
